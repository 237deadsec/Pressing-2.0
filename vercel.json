{
  "version": 2,
  "builds": [
    { "src": "server.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "server.js" },
    { "src": "/suivi/(.*)", "dest": "public/suivi.html" },
    { "src": "/sw\\.js", "dest": "public/sw.js", "headers": { "Cache-Control": "no-cache", "Service-Worker-Allowed": "/" } },
    { "src": "/manifest\\.json", "dest": "public/manifest.json" },
    { "src": "/offline\\.html", "dest": "public/offline.html" },
    { "src": "/icons/(.*)", "dest": "public/icons/$1" },
    { "src": "/(.*\\.(js|css|ico|png|svg|jpg|jpeg|gif|woff2?|json|webmanifest))", "dest": "public/$1" },
    { "src": "/(.*)", "dest": "public/index.html" }
  ]
}
